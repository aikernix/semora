EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_UPLOAD_MAX_BYTES=26214400
KNOWLEDGE_WORKER_POLL_SECONDS=1
KNOWLEDGE_JOB_LEASE_SECONDS=900
KNOWLEDGE_OBJECT_STORE=s3
KNOWLEDGE_S3_ENDPOINT=http://object-store:8333
KNOWLEDGE_S3_BUCKET=semora-knowledge
KNOWLEDGE_S3_ACCESS_KEY=semora-knowledge-access
KNOWLEDGE_S3_SECRET_KEY=semora-object-store-dev
KNOWLEDGE_S3_REGION=us-east-1
KNOWLEDGE_S3_SSE_MODE=disabled
KNOWLEDGE_S3_KMS_KEY_ID=
KNOWLEDGE_S3_REQUIRE_VERSIONING=false
AUDIT_ARCHIVE_S3_SSE_MODE=disabled
AUDIT_ARCHIVE_S3_KMS_KEY_ID=
AUDIT_ARCHIVE_S3_REQUIRE_VERSIONING=false
OCR_MODE=tesseract
OCR_LANG=chi_sim+eng
OCR_TIMEOUT_SECONDS=60
OCR_PDF_SCALE=2.0
OCR_MAX_PIXELS=50000000
OCR_MAX_PDF_PAGES=200
OIDC_ISSUER=http://localhost:8088/realms/semora
AUTH_REQUIRED=false

# MVP knowledge provider. WeKnora performs the ReAct/wiki graph research and
# returns the final answer, tool trace and source references to Semora.
KNOWLEDGE_PROVIDER=weknora
SEMORA_WEKNORA_BASE_URL=https://your-weknora.example.com/api/v1
SEMORA_WEKNORA_API_KEY=
WEKNORA_AGENT_ID=builtin-wiki-researcher
WEKNORA_AGENT_TIMEOUT_SECONDS=180

# Local host ports. Defaults avoid the AskOda demo ports when both projects run.
SEMORA_POSTGRES_PORT=15433
SEMORA_OBJECT_STORE_PORT=19100
SEMORA_OBJECT_STORE_ADMIN_PORT=19101
VITE_KEYCLOAK_URL=http://localhost:8088
INTERNAL_TOKEN=semora-dev-internal
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MODE=optional
LLM_TIMEOUT_SECONDS=300
LLM_REQUEST_RETRIES=1
LLM_STREAM_ENABLED=true
LLM_STREAM_INCLUDE_USAGE=true
# Empty: provider default. Set false to disable thinking on supported models.
LLM_ENABLE_THINKING=
LLM_NO_DELIVERY_SECONDS=60
AGENT_MAX_NO_PROGRESS=3
AGENT_TIMEOUT_SECONDS=900
AGENT_CONTEXT_MAX_BYTES=256000
AGENT_ANALYST_CONTEXT_MAX_BYTES=131072


# Optional 51talk source credentials: injected into Executor only.
DATASOURCE_TALK51_CRM_URL=
DATASOURCE_TALK51_APPOINT_URL=
DATASOURCE_TALK51_LOG_URL=
DATASOURCE_TALK51_CONTENT_URL=



SEMORA_DEBUG_PAYLOADS=false
