        }
      },
      "required": [
        "answer"
      ],
      "title": "AnswerExplanation",
      "type": "object"
    },
    "CandidateBatch": {
      "$defs": {
        "CandidateProposal": {
          "properties": {
            "term": {
              "minLength": 1,
              "title": "Term",
              "type": "string"
            },
            "proposal": {
              "minLength": 1,
              "title": "Proposal",
              "type": "string"
            },
            "kind": {
              "enum": [
                "definition",
                "metric",
                "object",
                "property",
                "relation"
              ],
              "title": "Kind",
              "type": "string"
            },
            "patch": {
              "additionalProperties": true,
              "description": "definition为空；metric包含name、label、expression、grain、dimensions、format，引用当前对象属性；其他映射须原文明确支持。",
              "title": "Patch",
              "type": "object"
            },
            "evidence_chunk_id": {
              "description": "支撑候选的给定分块id。",
              "title": "Evidence Chunk Id",
              "type": "string"
            }
          },
          "required": [
            "term",
            "proposal",
            "kind",
            "patch",
            "evidence_chunk_id"
          ],
          "title": "CandidateProposal",
          "type": "object"
        }
      },
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidateProposal"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "candidates"
      ],
      "title": "CandidateBatch",
      "type": "object"
    },
    "KnowledgeAction": {
      "properties": {
        "action": {
          "enum": [
            "wiki_search",
            "wiki_read_page",
            "read_source",
            "finish"
          ],
          "title": "Action",
          "type": "string"
        },
        "kb_id": {
          "default": "",
          "description": "给定知识库准确ID；仅一个库时可省略。",
          "title": "Kb Id",
          "type": "string"
        },
        "query": {
          "default": "",
          "description": "搜索动作的一个短关键词或别名。",
          "title": "Query",
          "type": "string"
        },
        "slug": {
          "default": "",
          "description": "观察中已发现的页面标识。",
          "title": "Slug",
          "type": "string"
        },
        "document_id": {
          "default": "",
          "description": "已读内容引用的原文标识。",
          "title": "Document Id",
          "type": "string"
        },
        "page": {
          "default": 1,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "summary": {
          "default": "",
          "description": "finish时提交已取得事实、冲突与未知项。",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "KnowledgeAction",
      "type": "object"
    },
    "ContextSelection": {
      "additionalProperties": false,
      "properties": {
        "objects": {
          "description": "当前目录中完成需求必需的准确对象name。",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Objects",
          "type": "array"
        },
        "knowledge_keywords": {
          "description": "需要补充的业务知识主题，每项一个短关键词。",
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Knowledge Keywords",
          "type": "array"
        }
      },
      "title": "ContextSelection",
      "type": "object"
    },
    "InformationAssessment": {
      "$defs": {
        "ClarificationOption": {
          "properties": {
            "id": {
              "title": "Id",
              "type": "string"
            },
            "label": {
              "title": "Label",
              "type": "string"
            },
            "value": {
              "title": "Value",
              "type": "string"
            },
            "description": {
              "default": "",
              "title": "Description",
              "type": "string"
            }
          },
          "required": [
            "id",
            "label",
            "value"
          ],
          "title": "ClarificationOption",
          "type": "object"
        },
        "ClarificationQuestion": {
          "properties": {
            "id": {
              "title": "Id",
              "type": "string"
            },
            "field": {
              "title": "Field",
              "type": "string"
            },
            "question": {
              "description": "面向业务用户的具体问题。",
              "title": "Question",
              "type": "string"
            },
            "reason": {
              "description": "该选择会影响什么结果。",
              "title": "Reason",
              "type": "string"
            },
            "options": {
              "description": "可选业务解释，同时允许用户自由补充。",
              "items": {
                "$ref": "#/$defs/ClarificationOption"
              },
              "title": "Options",
              "type": "array"
            },
            "allow_free_text": {
              "default": true,
              "title": "Allow Free Text",
              "type": "boolean"
            },
            "blocking": {
              "default": true,
              "title": "Blocking",
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "field",
            "question",
            "reason"
          ],
          "title": "ClarificationQuestion",
          "type": "object"
        },
        "EntitySelection": {
          "additionalProperties": false,
          "properties": {
            "entity_field": {
              "minLength": 1,
              "title": "Entity Field",
              "type": "string"
            },
            "time_field": {
              "minLength": 1,
              "title": "Time Field",
              "type": "string"
            },
            "limit": {
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "direction": {
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "title": "Direction",
              "type": "string"
            },
            "mode": {
              "default": "entities",
              "enum": [
                "entities",
                "records"
              ],
              "title": "Mode",
              "type": "string"
            }
          },
          "required": [
            "entity_field",
            "time_field",
            "limit"
          ],
          "title": "EntitySelection",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "sufficient",
            "ambiguous",
            "missing_core"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "clarifications": {
          "items": {
            "$ref": "#/$defs/ClarificationQuestion"
          },
          "maxItems": 3,
          "title": "Clarifications",
          "type": "array"
        },
        "missing_objects": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Missing Objects",
          "type": "array"
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "output",
                "filter",
                "time",
                "join",
                "aggregation",
                "sort"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntitySelection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "InformationAssessment",
      "type": "object"
    }
  }
