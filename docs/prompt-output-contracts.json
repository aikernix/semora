          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale"
      ],
      "title": "ReviewPayload",
      "type": "object"
    },
    "SQLExplanation": {
      "properties": {
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "explanation"
      ],
      "title": "SQLExplanation",
      "type": "object"
    },
    "AnswerExplanation": {
      "properties": {
        "answer": {
          "minLength": 1,
