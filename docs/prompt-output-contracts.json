            "status",
            "rationale"
          ],
          "title": "ReviewResolution",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "findings": {
          "description": "具体问题对象放在此数组，包含位置、依据和验收条件；无问题为[]。",
          "items": {
            "$ref": "#/$defs/BoundedReviewFinding"
          },
          "maxItems": 8,
          "title": "Findings",
          "type": "array"
        },
        "resolutions": {
          "items": {
            "$ref": "#/$defs/ReviewResolution"
          },
          "maxItems": 24,
          "title": "Resolutions",
          "type": "array"
        },
        "decision": {
          "description": "一致且无实质问题为approved；可修复为revise；不允许的操作为rejected。",
          "enum": [
